{
  "name": "@deepseekharness-mobile/companion",
  "version": "0.1.1",
  "description": "DSH host plugin: WebSocket bridge, QR pairing and device tokens for DSH Mobile",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joseph12n/dsh-mobile.git",
    "directory": "packages/companion"
  },
  "homepage": "https://github.com/joseph12n/dsh-mobile/tree/main/packages/companion#readme",
  "bugs": {
    "url": "https://github.com/joseph12n/dsh-mobile/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "pwa",
    "remote-control",
    "dsh-mobile"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@deepseekharness-mobile/protocol": "workspace:*",
    "qrcode": "^1.5.4",
    "web-push": "^4.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.1",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
